---
import { Image } from 'astro:assets';
import Layout from '../components/Layout.astro';
import headshot from '../images/headshot.jpg';
---

<Layout title="Home">
  <div class="home">
    <Image src={headshot} class="headshot" alt="" />
    <div class="about-me">
      <h1>Michael Dermksian</h1>
      <p>
        I'm a robotics and controls engineer working in the surgical robotics
        field. I'm always in pursuit of unsolved problems, impactful solutions,
        and a team of driven people to help bridge the gap. In recent years,
        I've discovered a latent love for sharing knowledge and helping to build
        collaborative, healthy teams.
      </p>
      <p>
        Come take a look at the things I've done and get a sense for who I am.
        Shoot me an email, connect with me on LinkedIn, and lets build
        something awesome together.
      </p>
    </div>
  </div>
</Layout>

<style>
  .home {
    display: flex;
    flex-flow: row wrap;
    align-items: center;
    justify-content: space-around;
    margin-top: 15px;
  }

  h1 {
    margin-top: 20px;
    text-align: center;
  }

  .headshot {
    display: block;
    width: 30%;
    min-width: 230px;
    height: auto;
    border-radius: 10px;
  }

  .about-me {
    width: 60%;
    min-width: 230px;
  }
</style>
